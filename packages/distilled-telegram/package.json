{
  "name": "distilled-telegram",
  "version": "0.2.0",
  "description": "Generated Effect-native SDK for Telegram Bot API 10.3.",
  "keywords": [
    "api",
    "bot",
    "effect",
    "sdk",
    "telegram"
  ],
  "homepage": "https://github.com/lucasthevenet/alchemy-telegram#readme",
  "bugs": "https://github.com/lucasthevenet/alchemy-telegram/issues",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucasthevenet/alchemy-telegram.git",
    "directory": "packages/distilled-telegram"
  },
  "files": [
    "lib",
    "src",
    "API.md",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "bun": "./src/index.ts",
      "worker": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./Credentials": {
      "types": "./lib/credentials.d.ts",
      "bun": "./src/credentials.ts",
      "worker": "./src/credentials.ts",
      "default": "./lib/credentials.js"
    },
    "./Errors": {
      "types": "./lib/errors.d.ts",
      "bun": "./src/errors.ts",
      "worker": "./src/errors.ts",
      "default": "./lib/errors.js"
    },
    "./Protocol": {
      "types": "./lib/protocol.d.ts",
      "bun": "./src/protocol.ts",
      "worker": "./src/protocol.ts",
      "default": "./lib/protocol.js"
    },
    "./Retry": {
      "types": "./lib/retry.d.ts",
      "bun": "./src/retry.ts",
      "worker": "./src/retry.ts",
      "default": "./lib/retry.js"
    },
    "./Traits": {
      "types": "./lib/traits.d.ts",
      "bun": "./src/traits.ts",
      "worker": "./src/traits.ts",
      "default": "./lib/traits.js"
    },
    "./Files": {
      "types": "./lib/files.d.ts",
      "bun": "./src/files.ts",
      "worker": "./src/files.ts",
      "default": "./lib/files.js"
    },
    "./*": {
      "types": "./lib/services/*.d.ts",
      "bun": "./src/services/*.ts",
      "worker": "./src/services/*.ts",
      "default": "./lib/services/*.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -b",
    "update:spec": "bun scripts/update-spec.ts",
    "extract": "bun scripts/extract.ts",
    "generate": "bun scripts/extract.ts && bun scripts/generate-docs.ts && bun scripts/generate.ts",
    "generate:check": "bun scripts/check-generated.ts",
    "generate:sdk": "bun scripts/generate.ts",
    "typecheck": "tsc -p tsconfig.handwritten.json && tsc -p tsconfig.scripts.json && tsc -p tsconfig.json",
    "test": "bun test"
  },
  "dependencies": {
    "@distilled.cloud/core": "1.0.0-rc.6"
  },
  "devDependencies": {
    "@effect/platform-bun": ">=4.0.0-rc.111 || >=4.0.0",
    "@gramio/schema-parser": "1.2.0",
    "@types/bun": "latest",
    "@types/node": "latest",
    "cheerio": "1.2.0"
  },
  "peerDependencies": {
    "effect": ">=4.0.0-rc.111 || >=4.0.0"
  }
}
