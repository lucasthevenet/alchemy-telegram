{
  "name": "alchemy-telegram",
  "version": "0.2.0",
  "description": "Alchemy V2 providers and an Effect-native Telegram Bot application DSL.",
  "keywords": [
    "alchemy",
    "bot",
    "cloudflare",
    "effect",
    "telegram"
  ],
  "homepage": "https://github.com/lucasthevenet/alchemy-telegram#readme",
  "bugs": "https://github.com/lucasthevenet/alchemy-telegram/issues",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucasthevenet/alchemy-telegram.git",
    "directory": "packages/alchemy-telegram"
  },
  "files": [
    "lib",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "bun": "./src/index.ts",
      "worker": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./Cloudflare": {
      "types": "./lib/Cloudflare.d.ts",
      "bun": "./src/Cloudflare.ts",
      "worker": "./src/Cloudflare.ts",
      "default": "./lib/Cloudflare.js"
    },
    "./*": {
      "types": "./lib/*.d.ts",
      "bun": "./src/*.ts",
      "worker": "./src/*.ts",
      "default": "./lib/*.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "test:live": "TELEGRAM_LIVE=1 bun --env-file=../../.env test ./test/live/telegram.live.test.ts"
  },
  "dependencies": {
    "@distilled.cloud/core": "1.0.0-rc.6",
    "distilled-telegram": "0.2.0"
  },
  "devDependencies": {
    "@effect/platform-bun": ">=4.0.0-rc.111 || >=4.0.0",
    "@effect/platform-node": "4.0.0-rc.111",
    "@types/bun": "latest",
    "@types/node": "latest",
    "alchemy": "2.0.0-beta.74"
  },
  "peerDependencies": {
    "@effect/platform-node": ">=4.0.0-rc.111 || >=4.0.0",
    "alchemy": "2.0.0-beta.74",
    "effect": ">=4.0.0-rc.111 || >=4.0.0"
  }
}
