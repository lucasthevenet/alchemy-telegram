{
  "name": "alchemy-telegram",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/lucasthevenet/alchemy-telegram",
    "directory": "packages/alchemy-telegram"
  },
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "files": ["lib", "src"],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "bun": "./src/index.ts",
      "worker": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./*": {
      "types": "./lib/*.d.ts",
      "bun": "./src/*.ts",
      "worker": "./src/*.ts",
      "default": "./lib/*.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@distilled.cloud/core": "1.0.0-rc.6",
    "distilled-telegram": "0.1.0"
  },
  "devDependencies": {
    "@types/bun": "catalog:tooling",
    "@types/node": "catalog:tooling",
    "@effect/platform-bun": "catalog:effect",
    "alchemy": "2.0.0-beta.74"
  },
  "peerDependencies": {
    "alchemy": "2.0.0-beta.74",
    "effect": "catalog:effect"
  }
}
