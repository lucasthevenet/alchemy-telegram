{
  "format_on_save": "on",
  "formatter": [
    {
      "language_server": {
        "name": "oxfmt"
      }
    }
  ],
  "code_actions_on_format": {
    "source.organizeImports": true,
    "source.fixAll": true
  },
  "lsp": {
    "typescript-ls": {
      "binary": {
        "path": "node_modules/.bin/tsc",
        "arguments": ["--lsp", "--stdio"]
      }
    }
  },
  "languages": {
    "TypeScript": {
      "language_servers": ["typescript-ls", "!vtsls", "!typescript-language-server", "..."]
    },
    "TSX": {
      "language_servers": ["typescript-ls", "!vtsls", "!typescript-language-server", "..."]
    }
  }
}
